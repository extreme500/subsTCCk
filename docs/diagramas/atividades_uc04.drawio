<mxfile host="app.diagrams.net"><diagram name="Atividades UC04" id="uc04"><mxGraphModel dx="1260" dy="1130" grid="1" gridSize="10" guides="1" page="1" pageWidth="1260" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Diagrama de Atividades - UC04: Buscar e Filtrar TCCs" style="text;html=1;align=center;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="330.0" y="17" width="600" height="30" as="geometry"/></mxCell><mxCell id="raia0" value="Usuário Leitor&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;(Aluno Pesquisador, Professor ou Visitante)&lt;/font&gt;" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="300" height="44" as="geometry"/></mxCell><mxCell id="raia1" value="Sistema" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="300" height="44" as="geometry"/></mxCell><mxCell id="raia2" value="Armazenamento de Arquivos" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="300" height="44" as="geometry"/></mxCell><mxCell id="ini" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="1"><mxGeometry x="629.0" y="119.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="u1" value="Selecionar a opção&lt;br&gt;&quot;Buscar TCC&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255.0" y="163.0" width="150" height="44" as="geometry"/></mxCell><mxCell id="s1" value="Exibir barra de pesquisa&lt;br&gt;e botões de filtro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffffc0;strokeColor=#ff0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560.0" y="283.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="u2" value="Inserir termos e/ou&lt;br&gt;selecionar filtros (Ano,&lt;br&gt;Autor, Orientador, Tags)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250.0" y="279.0" width="160" height="52" as="geometry"/></mxCell><mxCell id="u3" value="Clicar em&lt;br&gt;&quot;Pesquisar&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255.0" y="363.0" width="150" height="44" as="geometry"/></mxCell><mxCell id="s2" value="Aplicar todos os filtros&lt;br&gt;simultaneamente (somente&lt;br&gt;TCCs PUBLICADOS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffffc0;strokeColor=#ff0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="555.0" y="359.0" width="170" height="52" as="geometry"/></mxCell><mxCell id="d1" value="Há trabalhos&lt;br&gt;compatíveis?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffc0;strokeColor=#ff0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575.0" y="445.0" width="130" height="70" as="geometry"/></mxCell><mxCell id="s3" value="Sistema exibe &quot;Nenhum&lt;br&gt;trabalho encontrado para os&lt;br&gt;critérios informados&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffffc0;strokeColor=#ff0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="555.0" y="551.0" width="170" height="58" as="geometry"/></mxCell><mxCell id="s4" value="Exibir resultados&lt;br&gt;em forma de feed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffffc0;strokeColor=#ff0000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="805.0" y="458.0" width="150" height="44" as="geometry"/></mxCell><mxCell id="u4" value="Selecionar o trabalho&lt;br&gt;listado desejado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="255.0" y="648.0" width="150" height="44" as="geometry"/></mxCell><mxCell id="s5" value="Exibir detalhe